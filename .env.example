# --- required in production
SECRET_KEY=change-me-to-a-long-random-string
APP_ENV=production
DATABASE_URL=postgresql://user:pass@host:5432/brandbatch
STORAGE_DIR=/data/storage
PUBLIC_URL=https://app.yourdomain.com
SUPPORT_EMAIL=support@yourdomain.com
# set to 1 when running behind a load balancer / platform proxy (Railway, Render, nginx)
TRUST_PROXY=1

# --- single-container deploys: run the render worker inside the web process
EMBEDDED_WORKER=0

# --- email (confirmation links). Without these the app runs, but links are only written to the log.
# Sender address, required by both transports below.
MAIL_FROM=brandbatch <nitcodein@gmail.com>
# Transport 1 (preferred): HTTPS API. Works on hosts that block SMTP ports, e.g. Railway
# Free/Trial/Hobby. Get the key at Brevo > SMTP & API > API Keys.
BREVO_API_KEY=
# Transport 2: SMTP. Used only when BREVO_API_KEY is empty.
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=

# --- anti-abuse
MAX_ACCOUNTS_PER_IP_PER_DAY=3
FREE_MINUTES_PER_IP_PER_DAY=30
DISPOSABLE_EXTRA=
IP_HASH_SALT=change-me-too

# --- limits
MAX_UPLOAD_MB=2048
RETENTION_HOURS=48

# --- Razorpay (leave empty to disable online payments)
RAZORPAY_KEY_ID=
RAZORPAY_KEY_SECRET=
RAZORPAY_WEBHOOK_SECRET=
RAZORPAY_PLAN_CREATOR=
RAZORPAY_PLAN_AGENCY=
RAZORPAY_PLAN_AGENCY_PRO=
